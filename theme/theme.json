{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Mulhouse au Cœur",
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "780px",
      "wideSize": "1220px"
    },
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": true,
      "palette": [
        {
          "slug": "primary",
          "color": "#1B3B6F",
          "name": "Bleu profond (Décrypter)"
        },
        {
          "slug": "secondary",
          "color": "#D84A38",
          "name": "Terracotta / Ocre (Débattre)"
        },
        {
          "slug": "accent-green",
          "color": "#2D7A58",
          "name": "Vert émeraude (Agir)"
        },
        {
          "slug": "accent-yellow",
          "color": "#E5A93C",
          "name": "Jaune chaleureux (Valoriser)"
        },
        {
          "slug": "dark",
          "color": "#181E29",
          "name": "Texte sombre / Anthracite"
        },
        {
          "slug": "light",
          "color": "#FFFFFF",
          "name": "Blanc"
        },
        {
          "slug": "surface",
          "color": "#F7F8FA",
          "name": "Fond clair doux"
        },
        {
          "slug": "border",
          "color": "#E2E5E9",
          "name": "Bordure subtile"
        },
        {
          "slug": "muted",
          "color": "#626D7C",
          "name": "Texte secondaire / Métadonnées"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "name": "Système & Moderne Sans",
          "slug": "body",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
        },
        {
          "name": "Éditorial & Titres",
          "slug": "heading",
          "fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.875rem",
          "name": "Petit (Métadonnées)"
        },
        {
          "slug": "medium",
          "size": "1.0625rem",
          "name": "Normal (Corps de texte)"
        },
        {
          "slug": "large",
          "size": "1.375rem",
          "name": "Grand (Chapô / Sous-titres)"
        },
        {
          "slug": "x-large",
          "size": "1.875rem",
          "name": "Très grand (Titres d'articles)"
        },
        {
          "slug": "huge",
          "size": "2.75rem",
          "name": "Hero / Titre principal"
        }
      ]
    },
    "spacing": {
      "spacingScale": {
        "operator": "*",
        "increment": 1.5,
        "steps": 7,
        "mediumStep": 3,
        "unit": "rem"
      },
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--light)",
      "text": "var(--wp--preset--color--dark)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.65"
    },
    "elements": {
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--dark)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "700",
          "lineHeight": "1.25"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        ":hover": {
          "typography": {
            "textDecoration": "underline"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--light)"
        },
        "typography": {
          "fontWeight": "600",
          "fontSize": "var(--wp--preset--font-size--small)"
        },
        "border": {
          "radius": "6px"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "bottom": "0.75rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        }
      }
    }
  }
}
