{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Mulhouse au Cœur",
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "820px",
      "wideSize": "1280px"
    },
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": true,
      "palette": [
        {
          "slug": "primary",
          "color": "#0F284E",
          "name": "Bleu Nuit Mulhouse"
        },
        {
          "slug": "primary-light",
          "color": "#E9F0FA",
          "name": "Bleu Pastel (Décrypter)"
        },
        {
          "slug": "secondary",
          "color": "#E1382B",
          "name": "Rouge Cœur / Terracotta"
        },
        {
          "slug": "secondary-light",
          "color": "#FEECEB",
          "name": "Terracotta Pastel (Débattre)"
        },
        {
          "slug": "accent-green",
          "color": "#1B8755",
          "name": "Vert Émeraude (Agir)"
        },
        {
          "slug": "accent-green-light",
          "color": "#EBF7F0",
          "name": "Vert Pastel"
        },
        {
          "slug": "accent-yellow",
          "color": "#D9822B",
          "name": "Ambre Vibrant (Valoriser)"
        },
        {
          "slug": "accent-yellow-light",
          "color": "#FEF7EC",
          "name": "Ambre Pastel"
        },
        {
          "slug": "dark",
          "color": "#111827",
          "name": "Anthracite Éditorial"
        },
        {
          "slug": "light",
          "color": "#FFFFFF",
          "name": "Blanc Pur"
        },
        {
          "slug": "surface",
          "color": "#F8FAFC",
          "name": "Fond Surface Moderne"
        },
        {
          "slug": "border",
          "color": "#E2E8F0",
          "name": "Bordure Subtile"
        },
        {
          "slug": "muted",
          "color": "#64748B",
          "name": "Texte Muted / Métadonnées"
        }
      ],
      "gradients": [
        {
          "slug": "gradient-primary",
          "gradient": "linear-gradient(135deg, #0F284E 0%, #1E4E8C 100%)",
          "name": "Dégradé Nuit Citoyenne"
        },
        {
          "slug": "gradient-accent",
          "gradient": "linear-gradient(135deg, #E1382B 0%, #F57242 100%)",
          "name": "Dégradé Cœur d'Action"
        },
        {
          "slug": "gradient-surface",
          "gradient": "linear-gradient(180deg, #FFFFFF 0%, #F8FAFC 100%)",
          "name": "Dégradé Surface Claire"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "name": "Plus Jakarta Sans",
          "slug": "heading",
          "fontFamily": "'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
        },
        {
          "name": "Inter",
          "slug": "body",
          "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "badge",
          "size": "0.75rem",
          "name": "Badge Catégorie"
        },
        {
          "slug": "small",
          "size": "0.875rem",
          "name": "Petit / Métadonnées"
        },
        {
          "slug": "medium",
          "size": "1.0625rem",
          "name": "Corps de Texte"
        },
        {
          "slug": "large",
          "size": "1.375rem",
          "name": "Grand / Titre Carte"
        },
        {
          "slug": "x-large",
          "size": "2rem",
          "name": "Très Grand / Titre Section"
        },
        {
          "slug": "huge",
          "size": "3rem",
          "name": "Titre Hero Majeur"
        }
      ]
    },
    "spacing": {
      "spacingScale": {
        "operator": "*",
        "increment": 1.5,
        "steps": 7,
        "mediumStep": 3,
        "unit": "rem"
      },
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--light)",
      "text": "var(--wp--preset--color--dark)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.7"
    },
    "elements": {
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--dark)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "800",
          "letterSpacing": "-0.02em",
          "lineHeight": "1.2"
        }
      },
      "link": {
        "color": "inherit",
        "typography": {
          "textDecoration": "none"
        },
        ":hover": {
          "color": "var(--wp--preset--color--secondary)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--light)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "700",
          "fontSize": "0.9375rem"
        },
        "border": {
          "radius": "9999px"
        },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "bottom": "0.85rem",
            "left": "1.75rem",
            "right": "1.75rem"
          }
        }
      }
    }
  }
}
